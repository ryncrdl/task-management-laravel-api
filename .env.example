# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME="Task Management API"
APP_ENV=local
APP_KEY=                          # Run: php artisan key:generate
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=task_management
DB_USERNAME=postgres
DB_PASSWORD=

# ─── JWT (tymon/jwt-auth) ─────────────────────────────────────────────────────
JWT_SECRET=                       # Run: php artisan jwt:secret
JWT_ALGO=HS256
JWT_TTL=60                        # Access token lifetime (minutes)
JWT_REFRESH_TTL=20160             # Refresh window (minutes, default = 14 days)

# ─── Node.js Service (for cross-service notifications) ────────────────────────
NODE_SERVICE_URL=http://localhost:3000
NODE_SERVICE_SECRET=your-inter-service-secret-here
                                  # Must match INTERNAL_SERVICE_SECRET in Node .env

# ─── Mail (Laravel mailer — Node.js handles transactional email) ──────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@taskmanagement.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Cache / Session / Queue ──────────────────────────────────────────────────
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
